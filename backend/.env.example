# ThermalShield Backend Environment Variables

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Google Maps API (Optional, for backend geocoding verification if needed)
GOOGLE_MAPS_API_KEY=

# Twilio Configuration for SMS & WhatsApp (Optional - Demo mode active when empty)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=

# SMTP Email Configuration (Optional - Demo preview active when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@thermalshield.org
