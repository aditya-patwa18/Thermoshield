# ThermalShield Backend Environment Variables

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Google Maps API (Optional, for backend geocoding verification if needed)
GOOGLE_MAPS_API_KEY=

# Twilio Configuration for SMS & WhatsApp (Optional - Demo mode active when empty)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=
# Twilio TRIAL accounts cannot send custom text: they only deliver Twilio's preset sample
# messages, and only to verified numbers. On a trial account the SMS channel sends this
# sample instead of the alert (sms_internal_alerts, sms_account_alerts, sms_event_notifications...).
# Leave empty to disable. Ignored once the Twilio account is upgraded.
TWILIO_TRIAL_TEMPLATE=sms_internal_alerts

# SMTP Email Configuration (Optional - Demo preview active when empty)
EMAIL_PROVIDER=smtp
TWILIO_EMAIL_FROM=
TWILIO_EMAIL_FROM_NAME=ThermalShield
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@thermalshield.org
